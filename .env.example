# ==============================================================================
# WILDLIFE CONSERVATION INTELLIGENCE PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Settings
# For PostgreSQL with PostGIS:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/wildlife_db
# For zero-dependency local testing / fallback:
FALLBACK_SQLITE_URL=sqlite:///./wildlife_dev.db

# Authentication & JWT Security
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# External API Integrations (Optional credentials, platform includes local sample caches)
GBIF_API_URL=https://api.gbif.org/v1
INATURALIST_API_URL=https://api.inaturalist.org/v1
EBIRD_API_KEY=mock_or_user_ebird_key_here
IUCN_API_KEY=mock_or_user_iucn_key_here

# NLP & ML Engine Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
ML_MODEL_DIR=./ml/models

# Server Environment
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0
